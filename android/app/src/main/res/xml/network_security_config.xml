<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext stays allowed for LAN / Tailscale / emulator addresses,
         which the user types in by hand (so they can't be listed here).
         The app itself refuses to send the device token over plain HTTP
         to a public host (ServerConfig.cleartextBlocked, ADR-0017); a
         public server must be reached over HTTPS/WSS. User-installed CAs are not trusted (platform default). -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
