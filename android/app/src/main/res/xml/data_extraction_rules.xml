<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0017: the device token lives in app data. allowBackup="false"
     stops cloud backup, but on Android 12+ device-to-device transfer
     still copies app data unless excluded here. A new phone gets its own
     token from scripts/devices.py instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
