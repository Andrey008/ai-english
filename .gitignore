# Project documentation (PRD, epics, stories, status tracking) is local-only working
# material for development with AI assistants — not committed to the repo.
/Docs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Android / Gradle
node_modules/
.gradle/
build/
*.iml
.idea/
local.properties
*.apk
*.aab

# macOS
.DS_Store

# Env / secrets
.env
.env.*
*.pem
*.key

# Logs and local data
*.log
/models/
/data/
/logs/
# Server runtime data: the SQLite DB holds real conversations; debug_audio
# holds raw mic captures. Character presets / scenarios next to them are
# seed content and ARE committed.
/server/data/*.db
/server/data/*.db-*
/server/data/debug_audio/

# Vendored external tools built for PoC spikes (not our code)
/poc/whisper.cpp/

# PoC binaries: downloadable Piper voice models (~60MB each), and audio
# samples, which include recordings of the developer's real and cloned
# voice — personal data, never for a public repo.
/poc/voices/*.onnx
/poc/**/*.wav
/poc/**/*.aiff

# Editor
.vscode/
